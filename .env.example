# Required Telegram credentials (get BOT_TOKEN from @BotFather)
BOT_TOKEN=
API_ID=
API_HASH=
ADMIN_IDS=

# Dashboard authentication: use a unique password with at least 16 characters
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=replace-with-a-long-random-password

# Optional group access: comma-separated Telegram chat IDs; leave blank if unused
ALLOWED_GROUP_IDS=

# Force join channel (bot must be an admin in the channel)
SUBSCRIBE_CHANNEL=0
SUBSCRIBE_CHANNEL_URL=

# Optional logging channel IDs; 0 disables each destination
LOGS_ID=0
LOGS_VIDEO_ID=0
LOGS_NSFW_ID=0
LOGS_IMG_ID=0
LOGS_PAID_ID=0
LOG_EXCEPTION=0

# Identity / data
BOT_NAME=all_downloader_bot
BOT_NAME_FOR_USERS=all_downloader_bot
USE_FIREBASE=false

# Resource limits
MAX_FILE_SIZE_GB=1.8
DOWNLOAD_TIMEOUT=900

# Optional TeraBox adapter: external extraction endpoint; disabled by default
TERABOX_ENABLED=true
TERABOX_API_ENDPOINT=https://ytshorts.savetube.me/api/v1/terabox-downloader
TERABOX_MAX_BYTES=1992294400
TERABOX_CONNECT_TIMEOUT=10
TERABOX_READ_TIMEOUT=30

# Startup validation
REQUIRE_VALID_CONFIG=true
TZ=Asia/Kolkata

# Progress card premium emoji (optional). Works only if the bot owns a Fragment username;
# otherwise Telegram shows the plain fallback emoji automatically.
PREMIUM_EMOJI_ENABLED=false
PREMIUM_EMOJI_SEARCH=
PREMIUM_EMOJI_DOWNLOAD=
PREMIUM_EMOJI_UPLOAD=
PREMIUM_EMOJI_DONE=
