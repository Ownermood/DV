# ===== Required (4 values) =====
# BOT_TOKEN from @BotFather, API_ID / API_HASH from https://my.telegram.org
BOT_TOKEN=
API_ID=
API_HASH=
# Your Telegram user ID (more admins: 111,222)
ADMIN_IDS=

# ===== Optional (leave as is if unsure) =====
# Bot username without @
BOT_NAME=Downloader_Villanbot
# Database name for users. Moving from an old bot? Put the OLD name here or old users miss broadcasts.
BOT_NAME_FOR_USERS=Downloader_Villanbot
# Force-join channel: channel ID (e.g. -100123...) + invite link. 0 = off
SUBSCRIBE_CHANNEL=0
SUBSCRIBE_CHANNEL_URL=
# Log channel ID, 0 = off
LOGS_ID=0
# Max download size in GB. Too big? Bot auto picks lower quality (1080p -> 720p).
MAX_FILE_SIZE_GB=4
# /start image: https link or photo file_id (can also be set from the admin panel)
START_IMAGE=
TZ=Asia/Kolkata
# Optional TeraBox token API (e.g. https://ntmterabox.me, token from @ntmteraapi). Leave empty if unused.
TERABOX_API_URL=
TERABOX_API_TOKEN=
# Optional: your own Cloudflare worker (github.com/mkhossainx/Terabox-Downloader-API), e.g. https://tera.you.workers.dev
TERABOX_WORKER_URL=
